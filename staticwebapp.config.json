{
  "routes": [
    {
      "route": "/interno",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/interno/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/internal/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{png,jpg,jpeg,svg,mp4,mp3,woff,ico}"]
  }
}
